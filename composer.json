{
    "name": "acseo/sylius-prometheus-metrics-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "sylius-observability",
        "sylius-metrics",
        "sylius-prometheus"
    ],
    "description": "Sylius Prometheus Metrics Plugin",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "sylius/sylius": "~1.14.0",
        "artprima/prometheus-metrics-bundle": "~1.16.0 || ~1.17.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": ["PKSA-gs8r-6kz6-pp56", "PKSA-gnn4-pxdg-q76m"]
        }
    },
    "scripts": {
        "phpunit": "phpunit tests/PHPUnit"
    },
    "autoload": {
        "psr-4": {
            "ACSEO\\SyliusPrometheusMetricsPlugin\\": "src/",
            "Tests\\ACSEO\\SyliusPrometheusMetricsPlugin\\": "tests/"
        }
    }
}
